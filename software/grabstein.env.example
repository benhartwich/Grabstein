# Einstellungen für den Flüsternden Grabstein
# Datei: /etc/grabstein/grabstein.env  –  nach Änderungen: sudo systemctl restart grabstein

# --- ElevenLabs (Werte aus dem ElevenLabs-Dashboard)
ELEVENLABS_AGENT_ID=
# API-Key: nötig für private Agenten und zum Erzeugen der Clips
ELEVENLABS_API_KEY=
# Stimme für die Flüster-Clips (Voice ID aus der Voice Library)
ELEVENLABS_VOICE_ID=

# Modelle: Clips in bester Qualität, Agent mit kurzer Reaktionszeit
CLIP_MODELL=eleven_v4
AGENT_MODELL=eleven_v4_turbo

# Gespräch mit dem Agenten ein (1) oder aus (0) – aus = nur Clips
LIVE_AGENT=1

# --- Zeiten (24 h)
AKTIV_AB=16:30
AKTIV_BIS=22:30
# bis zu dieser Uhrzeit nur liebe Clips, kein Gespräch
KINDER_MODUS_BIS=19:30

# --- Verhalten
# Radar so lange belegt = "jemand bleibt stehen"
STEHEN_SEKUNDEN=4
# Radar so lange frei = "jemand ist weg", Gespräch endet
WEG_SEKUNDEN=8
PAUSE_CLIP_SEKUNDEN=45
PAUSE_GESPRAECH_SEKUNDEN=120
GESPRAECH_MAX_SEKUNDEN=90
# Gesprächsminuten pro Abend (Kosten!)
GESPRAECH_BUDGET_MINUTEN=20
# Lautstärke 0-100
LAUTSTAERKE=75

# --- Anschlüsse (GPIO-Nummern, leer = Sensor nicht vorhanden)
PIR_PIN=17
RADAR_PIN=22

# Gesprächstexte im Log zeigen (0 = nein, empfohlen)
LOG_TRANSKRIPTE=0
